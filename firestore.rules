rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Role resolution (reads from Firestore config doc) ───
    //
    // Roles are stored in: artifacts/production/public/data/config/roles
    // Document structure: { admins: [email], coaches: [email], members: { email: fighterName } }
    // If the config doc is missing, all role checks deny (safe default).
    //

    function getRolesDoc() {
      return get(/databases/$(database)/documents/artifacts/production/public/data/config/roles).data;
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in getRolesDoc().admins;
    }

    function isCoach() {
      return request.auth != null
          && request.auth.token.email in getRolesDoc().coaches;
    }

    function isAdminOrCoach() {
      return isAdmin() || isCoach();
    }

    function isTeamMember() {
      return request.auth != null
          && request.auth.token.email in getRolesDoc().members;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // ─── Per-user schedule data (weeks / templates / meta) ───
    // Path: artifacts/production/users/{userKey}/{weeks|templates|meta}/...
    //
    // #1191/#1193: data is keyed by EMAIL (the stable id). The transitional
    // name-keyed branch has been removed (#1193) now that the app and data are
    // fully on email paths — a fighter owns only the doc keyed by their email.
    //
    // Team members can READ all fighters (needed for team view).
    // Only the fighter themselves or admin/coach can WRITE.
    //
    // These subcollections are enumerated EXPLICITLY (instead of a single
    // recursive `{document=**}` rule) so that eventLogs below can be private.
    // Firestore allow rules are ADDITIVE: a broad read grant cannot be narrowed
    // by a more specific rule, so the team-read wildcard must not cover
    // eventLogs. Nested `{document=**}` is kept WITHIN each named subcollection
    // to preserve the previous behavior exactly.
    match /artifacts/production/users/{userKey}/weeks/{document=**} {
      allow read: if isTeamMember();
      allow write: if isAdminOrCoach();
      allow write: if isAuthenticated()
        && request.auth.token.email == userKey;
    }
    match /artifacts/production/users/{userKey}/templates/{document=**} {
      allow read: if isTeamMember();
      allow write: if isAdminOrCoach();
      allow write: if isAuthenticated()
        && request.auth.token.email == userKey;
    }
    match /artifacts/production/users/{userKey}/meta/{document=**} {
      allow read: if isTeamMember();
      allow write: if isAdminOrCoach();
      allow write: if isAuthenticated()
        && request.auth.token.email == userKey;
    }

    // ─── Durable recurrence definitions (EventSeries — Slice 1) ───
    // Path: artifacts/production/users/{userKey}/eventSeries/{seriesId}
    //
    // Per-user recurrence-foundation records for user-created recurring
    // self-posted training. No Slice 1 consumer reads another user's
    // definitions, so read is OWNER-ONLY (team-read is deferred until a Slice 2
    // team-calendar consumer exists) — narrower than weeks, which IS team-read.
    // Write stays owner + admin/coach: an eventSeries document is co-written
    // with its initial week occurrences in ONE atomic batch, and the
    // "Vis som bruger" flow lets an admin/coach create a recurring series on
    // another fighter's calendar (isReadOnly === false), so the write grant
    // must match the weeks-path writers or the atomic batch would be denied.
    // NOT a generic wildcard: this enumerates only the eventSeries subcollection.
    match /artifacts/production/users/{userKey}/eventSeries/{document=**} {
      allow read: if isAuthenticated()
        && request.auth.token.email == userKey;
      allow write: if isAdminOrCoach();
      allow write: if isAuthenticated()
        && request.auth.token.email == userKey;
    }

    // ─── Private per-user training logs (EventLog) ───
    // Path: artifacts/production/users/{userKey}/eventLogs/{logId}
    //
    // Personal training logs are PRIVATE BY DEFAULT:
    //  • owner — read + write (request.auth.token.email == userKey).
    //  • admin — read ONLY (isAdmin()), and independent of whether the admin is
    //            also listed in `members`. No admin write.
    //  • coach, other team members, authenticated non-team, unauthenticated —
    //            denied (no matching allow rule grants them access).
    //
    // No broader user-scoped rule matches this path, so additive rules cannot
    // re-grant team-member or coach access. Any future EXPLICIT sharing would be
    // added here (e.g. an allow read gated on a `sharedWith` field) — not now.
    //
    // ─── Checkpoint B: bilateral new-model pair-integrity gate ───
    // A log create is split into THREE branches, discriminated by
    // `origin.type` and (for new-model origin) whether the referenced
    // aggregate already exists as an independent entry:
    //  1. Standalone (no `origin`) and legacy `self_posted_calendar_session`
    //     creates — UNCHANGED, exactly as before.
    //  2. `origin.type == 'new_model_calendar_entry'` created bilaterally: the
    //     matching `calendarEntries` document must exist, in the SAME atomic
    //     commit, with identity fields that agree (co-persistence PAIR
    //     INTEGRITY, not general one-log-per-occurrence uniqueness — does
    //     not prevent a second log for the same occurrence).
    //  3. `origin.type == 'new_model_calendar_entry'` referencing an
    //     ALREADY-PERSISTED independent entry (no `logRecordId`) — a
    //     unidirectional log->entry reference (TrainingLog.origin ->
    //     CalendarEntry); establishes referential integrity for this create,
    //     not I8 uniqueness. CalendarEntry is never mutated.
    function hasNewModelOrigin(data) {
      return 'origin' in data && data.origin.type == 'new_model_calendar_entry';
    }

    function logPairsWithAggregate(userKey, logId, logData) {
      let agg = getAfter(/databases/$(database)/documents/artifacts/production/users/$(userKey)/calendarEntries/$(logData.origin.aggregateId)).data;
      return agg.id == logData.origin.aggregateId
          && agg.occurrence.id == logData.origin.occurrenceId
          && agg.occurrence.id == logData.occurrence.id
          && agg.calendarEntry.id == logData.calendarEntry.id
          && agg.userId == userKey
          && agg.logRecordId == logData.id
          && logData.id == logId;
    }

    // ─── Log against an already-existing independent CalendarEntry ───
    // Additive, unidirectional (TrainingLog.origin -> CalendarEntry): the
    // referenced aggregate must already be PERSISTED (get, not getAfter — a
    // same-commit brand-new aggregate is invisible here, so this can never
    // overlap with the bilateral path above) and must be INDEPENDENT (no
    // logRecordId). Mirrors every identity check `logPairsWithAggregate`
    // performs except the aggregate->log back-reference, which an independent
    // entry has no field for. This is referential integrity for this create,
    // not one-log-per-occurrence uniqueness (I8 remains deferred, unchanged).
    function logReferencesExistingIndependentEntry(userKey, logId, logData) {
      let agg = get(/databases/$(database)/documents/artifacts/production/users/$(userKey)/calendarEntries/$(logData.origin.aggregateId)).data;
      return agg.id == logData.origin.aggregateId
          && agg.occurrence.id == logData.origin.occurrenceId
          && agg.occurrence.id == logData.occurrence.id
          && agg.calendarEntry.id == logData.calendarEntry.id
          && agg.userId == userKey
          && !('logRecordId' in agg)
          && logData.id == logId;
    }

    match /artifacts/production/users/{userKey}/eventLogs/{logId} {
      allow read: if isAuthenticated()
        && request.auth.token.email == userKey;
      allow read: if isAdmin();

      allow create: if isAuthenticated()
        && request.auth.token.email == userKey
        && !hasNewModelOrigin(request.resource.data);

      allow create: if isAuthenticated()
        && request.auth.token.email == userKey
        && hasNewModelOrigin(request.resource.data)
        && logPairsWithAggregate(userKey, logId, request.resource.data);

      allow create: if isAuthenticated()
        && request.auth.token.email == userKey
        && hasNewModelOrigin(request.resource.data)
        && logReferencesExistingIndependentEntry(userKey, logId, request.resource.data);

      // Checkpoint B: a paired new-model TrainingLog is create-once and
      // read-only in this slice — editing/deleting it is not implemented,
      // and allowing it would risk corrupting the bilaterally validated pair
      // identity or orphaning the immutable `calendarEntries` aggregate.
      // Classified on the EXISTING persisted `resource.data`, not
      // `request.resource.data` — an update must not be able to bypass this
      // by rewriting/removing `origin` in the replacement document.
      // Standalone (no origin) and legacy `self_posted_calendar_session`
      // logs are unaffected and keep their existing owner update/delete.
      allow update, delete: if isAuthenticated()
        && request.auth.token.email == userKey
        && !hasNewModelOrigin(resource.data);
    }

    // ─── Checkpoint B: separately persisted new-model calendar aggregate ───
    // Path: artifacts/production/users/{userKey}/calendarEntries/{aggregateId}
    //
    // Owner create + read; administrator read-only. No update, no delete —
    // no edit/delete lifecycle exists yet for this slice (least privilege).
    // Two create paths, discriminated by `logRecordId` presence: when present,
    // the matching `eventLogs` document must exist in the SAME atomic commit
    // with agreeing identity fields (bilateral, Checkpoint B); when ABSENT, an
    // independent CalendarEntry is created owner-scoped with identity/ownership
    // validation only (persisted CalendarEntry independence, I2) — no paired
    // log required. Coach/other team members/unauthenticated denied (no
    // matching allow; not covered by any broader wildcard).
    function aggregatePairsWithLog(userKey, aggregateId, aggData) {
      let log = getAfter(/databases/$(database)/documents/artifacts/production/users/$(userKey)/eventLogs/$(aggData.logRecordId)).data;
      return aggData.id == aggregateId
          && aggData.userId == userKey
          && hasNewModelOrigin(log)
          && log.origin.aggregateId == aggData.id
          && log.origin.occurrenceId == aggData.occurrence.id
          && log.occurrence.id == aggData.occurrence.id
          && log.calendarEntry.id == aggData.calendarEntry.id
          && log.id == aggData.logRecordId;
    }

    match /artifacts/production/users/{userKey}/calendarEntries/{aggregateId} {
      allow read: if isAuthenticated()
        && request.auth.token.email == userKey;
      allow read: if isAdmin();

      // Paired create (Checkpoint B): a `logRecordId` claims a co-persisted
      // TrainingLog, so the full bilateral pair-integrity check applies.
      allow create: if isAuthenticated()
        && request.auth.token.email == userKey
        && ('logRecordId' in request.resource.data)
        && aggregatePairsWithLog(userKey, aggregateId, request.resource.data);

      // Independent create (persisted CalendarEntry independence, I2): no
      // `logRecordId` => no paired TrainingLog is claimed, so owner-scoped
      // identity validation only — no getAfter(eventLogs), no pairing.
      allow create: if isAuthenticated()
        && request.auth.token.email == userKey
        && !('logRecordId' in request.resource.data)
        && request.resource.data.id == aggregateId
        && request.resource.data.userId == userKey;
    }

    // ─── Public catalogue & gyms ───
    // Readable by anyone (including unauthenticated users).
    // Writable only by admin/coach.
    match /artifacts/production/public/data/catalogue/{docId} {
      allow read: if true;
      allow write: if isAdminOrCoach();
    }
    match /artifacts/production/public/data/gyms/{docId} {
      allow read: if true;
      allow write: if isAdminOrCoach();
    }

    // ─── Public fighter profiles (#1196) ───
    // Path: artifacts/production/public/data/profiles/{emailKey}
    //
    // A profile is keyed by the fighter's email (the stable id from #1191).
    // Public (unauthenticated) readers see ONLY published profiles; team members
    // can also see unpublished drafts (for editing/preview). Writes are scoped:
    // admin/coach can edit any profile; a fighter can edit only their own
    // (the doc key equals their email).
    match /artifacts/production/public/data/profiles/{emailKey} {
      allow read: if resource.data.published == true || isTeamMember();
      allow write: if isAdminOrCoach()
                   || (isAuthenticated() && request.auth.token.email == emailKey);
    }

    // ─── Events (tournaments, seminars, social) ───
    // Readable by all team members.
    // Admin/coach can create/update/delete events.
    // Team members can update their own sign-up status.
    match /artifacts/production/public/data/events/{docId} {
      allow read: if isTeamMember();
      allow create, delete: if isAdminOrCoach();
      allow update: if isAdminOrCoach() || isTeamMember();
    }

    // ─── Invitations (#1201) ───
    // Path: artifacts/production/public/data/invitations/{docId}
    //
    // A team member invites others to an activity. The doc snapshots the
    // activity and maps invitees by EMAIL → response. Merged into each invitee's
    // calendar at render time (like event sign-ups).
    //  • read   — any team member (the merge needs to see all invitations).
    //  • create — a team member, and only as themselves (invitedBy == own email).
    //  • delete — the inviter, or an admin/coach.
    //  • update — the inviter/admin may change anything; an invitee may change
    //             ONLY their own response key in the invitees map.
    match /artifacts/production/public/data/invitations/{docId} {
      allow read: if isTeamMember();
      allow create: if isTeamMember()
                    && request.resource.data.invitedBy == request.auth.token.email;
      allow delete: if isAdminOrCoach()
                    || (isAuthenticated() && resource.data.invitedBy == request.auth.token.email);
      allow update: if isAdminOrCoach()
                    || (isAuthenticated() && resource.data.invitedBy == request.auth.token.email)
                    || (isTeamMember()
                        && request.resource.data.invitees.diff(resource.data.invitees)
                             .affectedKeys().hasOnly([request.auth.token.email]));
    }

    // ─── Config documents (roles, settings) ───
    // Path: artifacts/production/public/data/config/{docId}
    //
    // Readable by all authenticated users (app needs role lookups).
    // Only admin can write (manage roles, settings).
    match /artifacts/production/public/data/config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Shared team data (backlog, feedback, story-map) ───
    // Path: artifacts/production/public/data/{collection}/{docId}
    //
    // Super-admin only for now (both read and write).
    // Covers:  backlog/{id}, feedback/{id}, story-map/main
    match /artifacts/production/public/data/{collection}/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Public data parent document ───
    match /artifacts/production/public/data/{docId} {
      allow read, write: if isAdmin();
    }

    // ─── Legacy config path (kept for compatibility) ───
    // The active config is at public/data/config/{docId} (above).
    match /artifacts/production/public/config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Catch-all: deny everything else ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
